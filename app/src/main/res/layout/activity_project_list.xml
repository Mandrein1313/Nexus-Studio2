<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:fab="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1A1B26"
    android:fitsSystemWindows="true">

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fitsSystemWindows="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:fitsSystemWindows="true"
            android:background="#1A1B26">

            <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="#1A1B26"
                app:title="Projects"
                app:titleTextColor="#C0CAF5"
                app:contentInsetStartWithNavigation="0dp" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:fillViewport="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp"
                    android:paddingTop="20dp"
                    android:paddingBottom="88dp">

                    <!-- หัวแบบ Welcome -->
                    <ImageView
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:layout_gravity="center_horizontal"
                        android:src="@mipmap/ic_launcher"
                        android:contentDescription="@null" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:layout_marginTop="12dp"
                        android:text="Nexus Studio"
                        android:textColor="#C0CAF5"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="24dp"
                        android:text="เลือกโปรเจกต์ หรือสร้างใหม่"
                        android:textColor="#565F89"
                        android:textSize="13sp" />

                    <!-- โปรเจกต์ -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="โปรเจกต์ของฉัน"
                        android:textAllCaps="true"
                        android:textColor="#565F89"
                        android:textSize="11sp"
                        android:letterSpacing="0.06"
                        android:paddingBottom="6dp" />

                    <LinearLayout
                        android:id="@+id/projectRowsContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                    <TextView
                        android:id="@+id/tvNoProjects"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="ยังไม่มีโปรเจกต์ — กด ＋ เพื่อสร้าง"
                        android:textColor="#565F89"
                        android:textSize="14sp"
                        android:paddingTop="4dp"
                        android:paddingBottom="8dp"
                        android:visibility="gone" />

                    <!-- เริ่มต้น -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:text="เริ่มต้น"
                        android:textAllCaps="true"
                        android:textColor="#565F89"
                        android:textSize="11sp"
                        android:letterSpacing="0.06"
                        android:paddingBottom="4dp" />

                    <TextView
                        android:id="@+id/rowNewProject"
                        style="@style/WelcomeRow"
                        android:text="＋    สร้างโปรเจกต์ใหม่" />

                    <TextView
                        android:id="@+id/rowImportGithub"
                        style="@style/WelcomeRow"
                        android:text="⬇    นำเข้าจาก GitHub" />

                    <!-- ตั้งค่า -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:text="ตั้งค่า"
                        android:textAllCaps="true"
                        android:textColor="#565F89"
                        android:textSize="11sp"
                        android:letterSpacing="0.06"
                        android:paddingBottom="4dp" />

                    <TextView
                        android:id="@+id/rowAiSettings"
                        style="@style/WelcomeRow"
                        android:text="⚙    AI Settings" />

                    <TextView
                        android:id="@+id/rowGithubSettings"
                        style="@style/WelcomeRow"
                        android:text="☁    ตั้งค่า GitHub" />

                    <TextView
                        android:id="@+id/rowToggleTheme"
                        style="@style/WelcomeRow"
                        android:text="🎨    สลับธีม Editor" />

                    <TextView
                        android:id="@+id/rowAbout"
                        style="@style/WelcomeRow"
                        android:text="ℹ    เกี่ยวกับ Nexus Studio" />

                </LinearLayout>
            </ScrollView>
        </LinearLayout>

        <com.getbase.floatingactionbutton.FloatingActionsMenu
            android:id="@+id/multiple_actions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="16dp"
            fab:fab_addButtonColorNormal="#7AA2F7"
            fab:fab_addButtonColorPressed="#89B4FA"
            fab:fab_expandDirection="up">

            <com.getbase.floatingactionbutton.FloatingActionButton
                android:id="@+id/action_create"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                fab:fab_title="สร้างโปรเจกต์ใหม่"
                fab:fab_colorNormal="#7AA2F7"
                fab:fab_size="mini" />

            <com.getbase.floatingactionbutton.FloatingActionButton
                android:id="@+id/action_github"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                fab:fab_title="นำเข้าจาก GitHub"
                fab:fab_colorNormal="#BB9AF7"
                fab:fab_size="mini" />
        </com.getbase.floatingactionbutton.FloatingActionsMenu>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/nav_view"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="#1F2335"
        android:fitsSystemWindows="true"
        app:itemTextColor="#C0CAF5"
        app:itemIconTint="#7AA2F7"
        app:menu="@menu/menu_drawer_project" />
</androidx.drawerlayout.widget.DrawerLayout>