<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D0E14">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="24dp">

        <!-- หัวข้อ -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="MOBILE ANDROID IDE"
            android:textColor="#565F89"
            android:textSize="11sp"
            android:letterSpacing="0.12"
            android:paddingTop="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nexus Studio"
            android:textColor="#C0CAF5"
            android:textSize="28sp"
            android:textStyle="bold"
            android:paddingTop="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="เลือก Template สร้างโปรเจกต์ Gradle แล้วแก้โค้ด Java/Kotlin และ XML ได้จากมือถือ"
            android:textColor="#565F89"
            android:textSize="13sp"
            android:lineSpacingExtra="2dp"
            android:paddingTop="8dp"
            android:paddingBottom="20dp" />

        <!-- ปุ่ม New project -->
        <TextView
            android:id="@+id/btnNewProject"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+  New project"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:background="@drawable/bg_btn_new_project" />

        <!-- รายการโปรเจกต์ -->
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="20dp"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/projectRowsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <!-- Empty state -->
                <LinearLayout
                    android:id="@+id/emptyState"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:padding="24dp"
                    android:background="@drawable/bg_empty_card"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📁"
                        android:textSize="36sp"
                        android:paddingBottom="12dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="No projects yet"
                        android:textColor="#C0CAF5"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="เริ่มจาก No Activity, Empty, Basic, Drawer, Bottom navigation หรือ Tabbed"
                        android:textColor="#565F89"
                        android:textSize="13sp"
                        android:gravity="center"
                        android:paddingTop="8dp"
                        android:paddingBottom="16dp" />

                    <TextView
                        android:id="@+id/btnChooseTemplate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Choose a template"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:paddingStart="18dp"
                        android:paddingEnd="18dp"
                        android:paddingTop="10dp"
                        android:paddingBottom="10dp"
                        android:background="@drawable/bg_btn_new_project" />
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>
</FrameLayout>