<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1A1B26"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:fitsSystemWindows="true">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="#1A1B26"
            app:titleTextColor="#C0CAF5"
            app:popupTheme="@style/ThemeOverlay.AppCompat.Dark" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="#1F2335"
            android:padding="6dp">

            <TextView
                android:id="@+id/tvFilePath"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="No file open"
                android:textColor="#565F89"
                android:textSize="12sp"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tvSaveStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Saved"
                android:textColor="#9ECE6A"
                android:textSize="12sp"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/tabRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:background="#1F2335"
            android:scrollbars="none" />

        <!-- searchBar -->
        <LinearLayout
            android:id="@+id/searchBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#24283B"
            android:paddingStart="10dp"
            android:paddingEnd="8dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <EditText
                    android:id="@+id/etFind"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:hint="ค้นหา..."
                    android:textColor="#C0CAF5"
                    android:textColorHint="#565F89"
                    android:textSize="14sp"
                    android:singleLine="true"
                    android:imeOptions="actionSearch"
                    android:background="@android:color/transparent"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp" />

                <TextView
                    android:id="@+id/tvSearchCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0/0"
                    android:textColor="#565F89"
                    android:textSize="12sp"
                    android:layout_marginEnd="6dp" />

                <ImageButton
                    android:id="@+id/btnSearchPrev"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@android:drawable/arrow_up_float"
                    android:contentDescription="ก่อนหน้า"
                    app:tint="#A9B1D6" />

                <ImageButton
                    android:id="@+id/btnSearchNext"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@android:drawable/arrow_down_float"
                    android:contentDescription="ถัดไป"
                    app:tint="#A9B1D6" />

                <ImageButton
                    android:id="@+id/btnCloseSearch"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@android:drawable/ic_menu_close_clear_cancel"
                    android:contentDescription="ปิด"
                    app:tint="#A9B1D6" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="4dp">

                <EditText
                    android:id="@+id/etReplace"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:hint="แทนที่ด้วย..."
                    android:textColor="#C0CAF5"
                    android:textColorHint="#565F89"
                    android:textSize="14sp"
                    android:singleLine="true"
                    android:background="@android:color/transparent"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp" />

                <TextView
                    android:id="@+id/btnReplace"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="แทนที่"
                    android:textColor="#7AA2F7"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/btnReplaceAll"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="ทั้งหมด"
                    android:textColor="#BB9AF7"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="2dp">

                <CheckBox
                    android:id="@+id/cbCaseSensitive"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ตัวพิมพ์เล็ก-ใหญ่"
                    android:textColor="#A9B1D6"
                    android:textSize="12sp"
                    android:buttonTint="#7AA2F7" />
            </LinearLayout>
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="#1A1B26">

            <!-- ไม่มี Welcome แล้ว — ข้อความสั้นเมื่อยังไม่เปิดไฟล์ -->
            <FrameLayout
                android:id="@+id/emptyStateView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="visible"
                android:background="#1A1B26">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="เปิดไฟล์จากเมนูซ้าย"
                    android:textColor="#565F89"
                    android:textSize="15sp" />
            </FrameLayout>

            <io.github.rosemoe.sora.widget.CodeEditor
                android:id="@+id/codeEditor"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone" />

            <FrameLayout
                android:id="@+id/previewContainer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#1A1B26"
                android:visibility="gone" />
        </FrameLayout>

        <!-- แถบล่าง -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1F2335">

            <LinearLayout
                android:id="@+id/shortcutRow"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:visibility="gone">

                <HorizontalScrollView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/shortcutBar"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:gravity="center_vertical" />
                </HorizontalScrollView>

                <LinearLayout
                    android:id="@+id/aiShortcutBar"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="4dp"
                    android:paddingEnd="6dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/mainShortcutRow"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="4dp"
                android:paddingEnd="8dp"
                android:background="#1A1B26">

                <ImageView
                    android:id="@+id/btnToggleShortcut"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:padding="8dp"
                    android:src="@drawable/ic_expand_more_24"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Toggle shortcuts"
                    android:scaleType="centerInside" />

                <HorizontalScrollView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:scrollbars="none"
                    android:fillViewport="false">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:id="@+id/btnUndo"
                            android:layout_width="40dp"
                            android:layout_height="36dp"
                            android:padding="6dp"
                            android:src="@drawable/ic_undo_24"
                            android:background="@drawable/bg_dialog_input"
                            android:layout_marginStart="4dp"
                            android:contentDescription="Undo"
                            android:scaleType="centerInside" />

                        <ImageView
                            android:id="@+id/btnRedo"
                            android:layout_width="40dp"
                            android:layout_height="36dp"
                            android:padding="6dp"
                            android:src="@drawable/ic_redo_24"
                            android:background="@drawable/bg_dialog_input"
                            android:layout_marginStart="4dp"
                            android:contentDescription="Redo"
                            android:scaleType="centerInside" />

                        <ImageView
                            android:id="@+id/btnColorPicker"
                            android:layout_width="40dp"
                            android:layout_height="36dp"
                            android:padding="6dp"
                            android:src="@drawable/ic_palette_24"
                            android:background="@drawable/bg_dialog_input"
                            android:layout_marginStart="4dp"
                            android:contentDescription="Color Picker"
                            android:scaleType="centerInside" />

                        <ImageView
                            android:id="@+id/btnPreview"
                            android:layout_width="40dp"
                            android:layout_height="36dp"
                            android:padding="6dp"
                            android:src="@drawable/ic_preview_24"
                            android:background="@drawable/bg_dialog_input"
                            android:layout_marginStart="4dp"
                            android:contentDescription="Preview"
                            android:scaleType="centerInside" />

                        <ImageView
                            android:id="@+id/btnFileSearch"
                            android:layout_width="40dp"
                            android:layout_height="36dp"
                            android:padding="6dp"
                            android:src="@drawable/ic_search_file_24"
                            android:background="@drawable/bg_dialog_input"
                            android:layout_marginStart="4dp"
                            android:contentDescription="ค้นหาไฟล์"
                            android:scaleType="centerInside" />

                        <ImageView
                            android:id="@+id/btnGitPush"
                            android:layout_width="40dp"
                            android:layout_height="36dp"
                            android:padding="6dp"
                            android:src="@drawable/ic_git_push_24"
                            android:background="@drawable/bg_dialog_input"
                            android:layout_marginStart="4dp"
                            android:contentDescription="Push to GitHub"
                            android:scaleType="centerInside" />
                    </LinearLayout>
                </HorizontalScrollView>

                <ImageView
                    android:id="@+id/btnMainAi"
                    android:layout_width="40dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="8dp"
                    android:padding="6dp"
                    android:src="@drawable/ic_ai_24"
                    android:background="@drawable/bg_dialog_input"
                    android:contentDescription="AI"
                    android:scaleType="centerInside" />
            </LinearLayout>
        </LinearLayout>

        <!-- consolePanel ใหม่ -->
        <LinearLayout
            android:id="@+id/consolePanel"
            android:layout_width="match_parent"
            android:layout_height="240dp"
            android:orientation="vertical"
            android:background="#1A1B26"
            android:visibility="gone">

            <!-- แถบปุ่ม Run / Stop / Clear -->
            <LinearLayout
                android:id="@+id/consoleToolbar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:background="#16161E">

                <TextView
                    android:id="@+id/btnConsoleRun"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:gravity="center"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="▶  Run"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_btn_console_run" />

                <TextView
                    android:id="@+id/btnConsoleStop"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginStart="8dp"
                    android:gravity="center"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:text="■  Stop"
                    android:textColor="#C0CAF5"
                    android:textSize="13sp"
                    android:background="@drawable/bg_btn_console_secondary" />

                <TextView
                    android:id="@+id/btnConsoleClear"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginStart="8dp"
                    android:gravity="center"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:text="🗑  Clear"
                    android:textColor="#C0CAF5"
                    android:textSize="13sp"
                    android:background="@drawable/bg_btn_console_secondary" />

                <TextView
                    android:id="@+id/tvConsoleMeta"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end|center_vertical"
                    android:paddingStart="8dp"
                    android:text="minSdk 24 · java"
                    android:textColor="#565F89"
                    android:textSize="11sp" />

                <!-- ปุ่มปิดแผง -->
                <ImageButton
                    android:id="@+id/btnCloseConsole"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="4dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@android:drawable/ic_menu_close_clear_cancel"
                    android:contentDescription="ปิด"
                    app:tint="#F7768E" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#292E42" />

            <ScrollView
                android:id="@+id/consoleScrollView"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:fillViewport="true"
                android:background="#1A1B26">

                <TextView
                    android:id="@+id/tvConsole"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="12dp"
                    android:textColor="#A9B1D6"
                    android:textSize="12sp"
                    android:typeface="monospace"
                    android:textIsSelectable="true"
                    android:lineSpacingExtra="2dp" />
            </ScrollView>
        </LinearLayout>
    </LinearLayout>
</androidx.drawerlayout.widget.DrawerLayout>
