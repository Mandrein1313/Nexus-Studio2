<resources>
    <style name="AppTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">#1A1B26</item>
        <item name="colorPrimaryDark">#1A1B26</item>
        <item name="colorAccent">#7AA2F7</item>
        <item name="android:windowBackground">#0D0E14</item>

        <item name="android:statusBarColor">#1A1B26</item>
        <item name="android:navigationBarColor">#1A1B26</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <!-- แถวในหน้า Welcome (สไตล์ Acode) -->
    <style name="WelcomeRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:textColor">#C0CAF5</item>
        <item name="android:textSize">15sp</item>
        <item name="android:background">?attr/selectableItemBackground</item>
    </style>
</resources>
